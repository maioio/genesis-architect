{
  "name": "genesis-architect",
  "version": "9.0.0",
  "description": "Research before you build. Understand before you change. Genesis Architect mines real GitHub issues and post-mortems to scaffold new projects (genesis init) and to diagnose existing ones (genesis recover).",
  "author": "Maio Eshet",
  "license": "AGPL-3.0-or-later",
  "categories": [
    "scaffolding",
    "research",
    "architecture"
  ],
  "triggers": [
    "genesis init",
    "I want to build",
    "scaffold",
    "new project",
    "start building",
    "create a tool",
    "make a CLI",
    "bootstrap"
  ],
  "tools_required": [],
  "optional_mcps": [
    "github-mcp",
    "exa",
    "firecrawl"
  ],
  "fallback": "web-search",
  "install": {
    "claude_code": "git clone https://github.com/maioio/genesis-architect ~/.claude/skills/genesis-architect",
    "skills_sh": "npx skills add maioio/genesis-architect",
    "cursor": "Copy SKILL.md to .cursor/rules/genesis-architect.md",
    "codex": "git clone https://github.com/maioio/genesis-architect ~/.codex/skills/genesis-architect"
  },
  "homepage": "https://github.com/maioio/genesis-architect",
  "website": "https://maioio.github.io/genesis-architect/"
}
